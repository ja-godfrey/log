.DS_Store
.gitignore
node_modules
public
prof
tsconfig.tsbuildinfo
.obsidian
.quartz-cache
private/
.replit
replit.nix

# Ignore CSV files (Comma-Separated Values)
*.csv
google-analytics.py

# Ignore Excel files
*.xls
*.xlsx
*.xlsm
*.xlsb

# Ignore JSON files (JavaScript Object Notation)
*.json

# Ignore Parquet files (Columnar storage format)
*.parquet

# Ignore SQL database files
*.db
*.sqlite
*.sqlite3

# Ignore Pickle files (Python object serialization)
*.pkl
*.pickle

# Generated interactive exports and additional data artifacts
*.html
# ...except charts published with the log. The blanket rule above is for
# generated data artefacts; without this exception it silently untracks
# site content and every note linking to /html-files/ 404s.
!content/html-files/*.html
*.rda
*.rds
*.feather
*.arrow
*.dta
*.sav
*.sas7bdat
*.geojson

#custom
nothing.txt

# Claude Code local files (not pushed)
CLAUDE.md
.claude/
memory/
